# Desarrollo local. En producción, usar un secret manager y reemplazar todo.
POSTGRES_PASSWORD=contable
POSTGRES_DB=contable_demo
RUNTIME_DB_PASSWORD=runtime_secret
WORKER_DB_PASSWORD=worker_secret
# Puertos host configurables; los servicios se comunican internamente por sus
# puertos estándar. Son útiles para ejecutar stacks aislados en paralelo.
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_USE_SSL=false
MINIO_REGION=us-east-1
VALKEY_PORT=6379
CLAMAV_PORT_HOST=3310
API_PORT=3000
WEB_PORT=8080
MINIO_SECRET_KEY=contable-minio
AI_SERVICE_SECRET=replace-with-at-least-32-random-characters
MFA_CHALLENGE_SECRET=replace-with-at-least-32-random-characters
# 32 bytes codificados en base64: `openssl rand -base64 32`
MFA_ENCRYPTION_KEY=

# OpenRouter (asistente y extracción). La clave es compartida; sin clave y sin
# modelo el asistente responde de forma determinista y el BI mantiene planner validado.
OPENROUTER_API_KEY=
# Asistente: vacío por defecto. Único valor permitido: anthropic/claude-haiku-5.5
# (allowlist en services/ai/app/openrouter_policy.py; ADR-0010).
OPENROUTER_MODEL=
# Compuerta del asistente (ADR-0010). false = nunca llama a OpenRouter aunque haya
# clave y modelo. Sólo se activa para pruebas explícitas con datos sintéticos.
ASSISTANT_OPENROUTER_ENABLED=false
# Extracción documental multimodal. El modelo/proveedores aprobados están en
# docs/adr/0009-modelo-extraccion-claude-haiku-5-5.md. En producción, los datos
# de clientes permanecen bloqueados hasta activar explícitamente la compuerta.
EXTRACTION_ENGINE=model
EXTRACTION_MODEL=anthropic/claude-haiku-5.5
EXTRACTION_CUSTOMER_DATA_ENABLED=false
EXTRACTION_MODEL_TIMEOUT_SECONDS=55
EXTRACTION_WORKER_TIMEOUT_MS=75000
EXTRACTION_INPUT_USD_PER_MILLION_TOKENS=
EXTRACTION_OUTPUT_USD_PER_MILLION_TOKENS=

# Proveedor interno de emails/notificaciones. Mientras esté vacío, los jobs
# fallan y se conservan en BullMQ para reintento; nunca se marcan como enviados.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
