# Desarrollo local. En producción, usar un secret manager y reemplazar todo.
POSTGRES_PASSWORD=contable
POSTGRES_DB=contable_demo
RUNTIME_DB_PASSWORD=runtime_secret
WORKER_DB_PASSWORD=worker_secret
# Puertos host configurables; los servicios se comunican internamente por sus
# puertos estándar. Son útiles para ejecutar stacks aislados en paralelo.
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_USE_SSL=false
MINIO_REGION=us-east-1
VALKEY_PORT=6379
CLAMAV_PORT_HOST=3310
API_PORT=3000
WEB_PORT=8080
MINIO_SECRET_KEY=contable-minio
AI_SERVICE_SECRET=replace-with-at-least-32-random-characters
MFA_CHALLENGE_SECRET=replace-with-at-least-32-random-characters
# 32 bytes codificados en base64: `openssl rand -base64 32`
MFA_ENCRYPTION_KEY=

# Opcional: redacción generativa sobre resultados canónicos. Sin estas variables,
# el asistente funciona en modo determinista y el BI mantiene planner validado.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Extracción documental multimodal. EXTRACTION_MODEL permanece vacío hasta que
# el ID y los proveedores estén en la allowlist ZDR de ADR-0005.
EXTRACTION_ENGINE=model
EXTRACTION_MODEL=
EXTRACTION_MODEL_TIMEOUT_SECONDS=55
EXTRACTION_WORKER_TIMEOUT_MS=75000
EXTRACTION_INPUT_USD_PER_MILLION_TOKENS=
EXTRACTION_OUTPUT_USD_PER_MILLION_TOKENS=

# Proveedor interno de emails/notificaciones. Mientras esté vacío, los jobs
# fallan y se conservan en BullMQ para reintento; nunca se marcan como enviados.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
