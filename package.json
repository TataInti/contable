{
  "name": "contable",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma contable multiestudio para estudios argentinos",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w @contable/api",
    "test:engine": "npm run test -w @contable/accounting-engine",
    "test:e2e": "playwright test",
    "dev": "npm run dev --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
