  @@index([firmId, clientId, workpaperId, status])
  @@index([firmId, clientId, counterpartyCuit])
  @@map("workpaper_voucher_classifications")
}

model TaxInputAllocation {
  id             String   @id @default(uuid(7))
  firmId         String
  clientId       String
  workpaperId    String?
  obligationId   String?
  sourceCode     String?
  sourceType     String
  sourceId       String
