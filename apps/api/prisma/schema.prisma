  taxType      TaxType      @relation(fields: [taxTypeId], references: [id])
  allocations  TaxCreditAllocation[]

  @@index([firmId, clientId, taxTypeId])
  @@map("tax_credit_ledger_entries")
}

model TaxCreditAllocation {
  id            String   @id @default(uuid(7))
  firmId        String
  clientId      String
  creditEntryId String
  settlementId  String
  amount        Decimal  @db.Decimal(20, 4)
  createdAt     DateTime @default(now())

  client       Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creditEntry  TaxCreditLedgerEntry   @relation(fields: [creditEntryId], references: [id], onDelete: Cascade)
  settlement   TaxSettlement          @relation(fields: [settlementId], references: [id])

  @@unique([creditEntryId, settlementId])
  @@index([firmId, clientId, settlementId])
  @@map("tax_credit_allocations")
}

model TaxExportArtifact {
  id               String   @id @default(uuid(7))
  firmId           String
  clientId         String
  settlementId     String
  kind             String
  format           String
  objectKey        String?
  checksum         String?
  generatedByUserId String
  generatedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  settlement TaxSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([firmId, clientId, settlementId])
  @@map("tax_export_artifacts")
}

model TaxFiling {
  id                String   @id @default(uuid(7))
  firmId            String
  clientId          String
  obligationId      String
  settlementId      String?
  filedAt           DateTime
