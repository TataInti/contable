model AssistantTurn {
  id               String   @id @default(uuid(7))
  firmId           String
  clientId         String
  conversationId   String
  role             String   @default("USER")
  content          String
  status           String   @default("COMPLETED")
  abstained        Boolean  @default(false)
  abstentionReason String?
