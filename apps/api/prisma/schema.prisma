  reviewedAt     DateTime?
  hash           String
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines  F931Line[]

  @@index([firmId, clientId, periodId])
  @@map("f931_runs")
}

model F931Line {
  id             String   @id @default(uuid(7))
  firmId         String
  clientId       String
  runId          String
  cuit           String
  remuneration   Decimal  @db.Decimal(20, 4)
  deduction      Decimal  @db.Decimal(20, 4)
  netRemuneration Decimal @db.Decimal(20, 4)
  position       Int
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  run    F931Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([firmId, clientId, runId])
  @@map("f931_lines")
}

model SupplierTaxProfile {
  id             String   @id @default(uuid(7))
  firmId         String
  clientId       String
  cuitNormalized String
  validFrom      DateTime
  validTo        DateTime?
  activityCode   String?
  categoryCode   String?
  jurisdictionId String?
  evidenceDocumentId String?
  createdByUserId String?
  reviewedByUserId String?
  status         String   @default("DRAFT")
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client          Client                           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  classifications WorkpaperVoucherClassification[]

  @@index([firmId, clientId, cuitNormalized])
  @@unique([clientId, cuitNormalized, version])
  @@map("supplier_tax_profiles")
}

// --- F1.1: libro de créditos inmutable (reemplaza balanceAfter mutable) ---

// B1 (plan piloto §3.1): estado de verificación de saldos. Un saldo sólo
// reduce un impuesto cuando está VERIFIED; los existentes migran pendientes.
enum TaxCreditLotStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUPERSEDED
}

model TaxCreditLot {
  id             String   @id @default(uuid(7))
  firmId         String
  clientId       String
  taxTypeId      String
  jurisdictionId String?
  regimeId       String?
  periodId       String?
  kind           String
  originalAmount Decimal  @db.Decimal(20, 4)
  sourceSettlementId String?
  sourcePaymentId String?
  evidenceDocumentId String?
  reference      String?
  verificationStatus TaxCreditLotStatus @default(PENDING_VERIFICATION)
  verifiedByUserId String?
  verifiedAt     DateTime?
  createdByUserId String
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdByUserId], references: [id])
  verifiedBy User? @relation("creditLotVerifiedBy", fields: [verifiedByUserId], references: [id])
  movements TaxCreditMovement[]
  history TaxCreditLotHistory[]

  @@index([firmId, clientId, taxTypeId])
  @@unique([sourceSettlementId, kind, jurisdictionId])
  @@map("tax_credit_lots")
}

model TaxCreditLotHistory {
  id             String   @id @default(uuid(7))
  lotId          String
  firmId         String
  clientId       String
  createdByUserId String
  createdAt      DateTime @default(now())
  changes        Json

  lot      TaxCreditLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdByUserId], references: [id])

  @@index([firmId, clientId, lotId])
  @@map("tax_credit_lot_history")
}

model TaxCreditMovement {
  id             String   @id @default(uuid(7))
  firmId         String
  clientId       String
  lotId          String
  kind           String
  amount         Decimal  @db.Decimal(20, 4)
  workpaperId    String?
  settlementId   String?
  reference      String?
  createdByUserId String
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lot    TaxCreditLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@index([firmId, clientId, lotId])
  @@map("tax_credit_movements")
}
