  resolvedByUserId String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  client     Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  settlement TaxSettlement?     @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([firmId, clientId, settlementId])
  @@map("tax_differences")
}

enum TaxDifferenceSeverity {
  INFO
  WARNING
  BLOCKING
}

enum TaxDifferenceStatus {
  OPEN
  RESOLVED
  WAIVED
}

model TaxCreditLedgerEntry {
  id          String   @id @default(uuid(7))
  firmId      String
  clientId    String
