model AssistantEvidence {
  id         String   @id @default(uuid(7))
  firmId     String
  clientId   String
  turnId     String
  kind       String   @default("ACCOUNT")
  sourceType String
  sourceId   String
  label      String?
  value      String?
  createdAt  DateTime @default(now())

  turn AssistantTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([firmId, clientId, turnId])
  @@map("assistant_evidence")
}

model AssistantFeedback {
  id              String   @id @default(uuid(7))
  firmId          String
  clientId        String
  turnId          String   @unique
  rating          Int?
  comment         String?
  createdByUserId String
  createdAt       DateTime @default(now())

  turn AssistantTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([firmId, clientId])
  @@map("assistant_feedback")
}

model AssistantUsage {
  id             String   @id @default(uuid(7))
  firmId         String
  clientId       String
  conversationId String?
  turnId         String?
  model          String
  provider       String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costUsd        Decimal  @default(0) @db.Decimal(20, 8)
  createdAt      DateTime @default(now())

  @@index([firmId, clientId])
  @@map("assistant_usage")
}

// ============================================================
// Fase 12 — Copiloto BI
// ============================================================

model BiMetric {
  id         String   @id @default(uuid(7))
  firmId     String
  clientId   String
  code       String
  name       String
  definition Json?
  version    Int      @default(1)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client  Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  widgets BiWidget[]

  @@unique([clientId, code, version])
  @@index([firmId, clientId])
  @@map("bi_metrics")
}

model BiDimension {
  id        String   @id @default(uuid(7))
  firmId    String
  clientId  String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, code])
  @@index([firmId, clientId])
  @@map("bi_dimensions")
}

model BiDashboard {
  id              String   @id @default(uuid(7))
  firmId          String
  clientId        String
  name            String
  layout          Json?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User         @relation("biDashboardCreatedBy", fields: [createdByUserId], references: [id])
  widgets   BiWidget[]
  snapshots BiSnapshot[]

  @@index([firmId, clientId])
  @@map("bi_dashboards")
}

model BiWidget {
  id          String    @id @default(uuid(7))
  firmId      String
  clientId    String
  dashboardId String
  metricId    String
  title       String
  plan        Json?
  cutoff      DateTime?
  status      String    @default("DRAFT")
  result      Json?
  resultHash  String?
  source      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dashboard BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  metric    BiMetric    @relation(fields: [metricId], references: [id])

  @@index([firmId, clientId, dashboardId])
  @@map("bi_widgets")
}

model BiSnapshot {
  id          String   @id @default(uuid(7))
  firmId      String
  clientId    String
  dashboardId String
  cutoff      DateTime
  resultHash  String?
  result      Json?
  createdAt   DateTime @default(now())

  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dashboard BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([firmId, clientId, dashboardId])
  @@map("bi_snapshots")
}

// ============================================================
// Fase 13 — Feature flags
// ============================================================

model FeatureFlag {
  id        String   @id @default(uuid(7))
  firmId    String
  clientId  String?
  code      String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([firmId, clientId, code])
  @@index([firmId, clientId])
  @@map("feature_flags")
}

// ============================================================
// Puerta 1 — Fundación fiscal (G1-01 a G1-05)
// Fuente: PLAN_DESARROLLO_CONTABLE.md §7.2, §7.3
// ============================================================

// --- Maestros: jurisdicción, autoridad, impuesto, régimen ---

model Jurisdiction {
  id        String   @id @default(uuid(7))
  code      String
  name      String
  kind      JurisdictionKind
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent        Jurisdiction?       @relation("jurisdictionTree", fields: [parentId], references: [id])
  children      Jurisdiction[]      @relation("jurisdictionTree")
  authorities   TaxAuthority[]
  regimes       TaxRegime[]
  activities    EconomicActivity[]
  dueDateRules  DueDateRule[]
  holidays      Holiday[]
  credentials   ProfessionalCredential[]
  settlements   TaxSettlement[]

  @@unique([code])
  @@index([parentId])
  @@map("jurisdictions")
}

enum JurisdictionKind {
  NATIONAL
  PROVINCIAL
  MUNICIPAL
}

model TaxAuthority {
  id             String   @id @default(uuid(7))
  code           String
  name           String
  jurisdictionId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  regimes      TaxRegime[]
  sources      NormativeSource[]
  credentials  ProfessionalCredential[]

  @@unique([code])
  @@index([jurisdictionId])
  @@map("tax_authorities")
}

model TaxType {
  id        String   @id @default(uuid(7))
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regimes            TaxRegime[]
  periods            TaxPeriod[]
  importBatches      ImportBatch[]
  settlements        TaxSettlement[]
  creditLedgerEntries TaxCreditLedgerEntry[]
  importAdapters     ImportAdapter[]

  @@unique([code])
  @@map("tax_types")
}

model TaxRegime {
  id             String   @id @default(uuid(7))
  code           String
  name           String
  taxTypeId      String
  jurisdictionId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  taxType        TaxType          @relation(fields: [taxTypeId], references: [id])
  jurisdiction   Jurisdiction     @relation(fields: [jurisdictionId], references: [id])
  authority      TaxAuthority     @relation(fields: [authorityId], references: [id])
  authorityId    String
  registrations  TaxRegistration[]
  obligations    TaxObligation[]
  rulePacks      TaxRulePack[]
  settlements    TaxSettlement[]

  @@unique([code])
  @@index([taxTypeId])
  @@index([jurisdictionId])
  @@map("tax_regimes")
}

// --- Perfil fiscal del contribuyente ---

model TaxpayerProfileVersion {
  id                 String                 @id @default(uuid(7))
  firmId             String
  clientId           String
  version            Int                    @default(1)
  legalName          String
  cuit               String
  personType         PersonType
  nationalCondition  NationalTaxCondition
  fiscalAddress      String?
  fiscalYearEndMonth Int                    @default(12)
  monotributoCategory String?
  validFrom          DateTime
  validTo            DateTime?
  status             TaxpayerProfileStatus  @default(DRAFT)
  source             String?
  createdByUserId    String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  activatedAt        DateTime?
  supersedesId       String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  registrations  TaxRegistration[]
  activities     ClientActivity[]
  obligations    TaxObligation[]

  @@unique([clientId, version])
  @@index([firmId, clientId, status])
  @@map("taxpayer_profile_versions")
}

enum PersonType {
  FISICA
  JURIDICA
}

enum NationalTaxCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTISTA
  EXENTO
  NO_RESPONSABLE
}

enum TaxpayerProfileStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  SUPERSEDED
}

model TaxRegistration {
  id                    String             @id @default(uuid(7))
  firmId                String
  clientId              String
  profileVersionId      String
  regimeId              String
  status                TaxRegistrationStatus @default(ACTIVE)
  validFrom             DateTime
  validTo               DateTime?
  registrationNumber    String?
  createdByUserId       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profile   TaxpayerProfileVersion @relation(fields: [profileVersionId], references: [id])
  regime    TaxRegime           @relation(fields: [regimeId], references: [id])

  @@index([firmId, clientId, regimeId])
  @@index([profileVersionId])
  @@map("tax_registrations")
}

enum TaxRegistrationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model EconomicActivity {
  id             String   @id @default(uuid(7))
  code           String
  name           String
  jurisdictionId String
  source         String?
  validFrom      DateTime
  validTo        DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jurisdiction Jurisdiction    @relation(fields: [jurisdictionId], references: [id])
  clientLinks  ClientActivity[]

  @@unique([code, jurisdictionId])
  @@index([jurisdictionId])
  @@map("economic_activities")
}

model ClientActivity {
  id                String   @id @default(uuid(7))
  firmId            String
  clientId          String
  profileVersionId  String
  activityId        String
  isPrimary         Boolean  @default(false)
  validFrom         DateTime
  validTo           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profile  TaxpayerProfileVersion @relation(fields: [profileVersionId], references: [id])
  activity EconomicActivity   @relation(fields: [activityId], references: [id])

  @@index([firmId, clientId, activityId])
  @@index([profileVersionId])
  @@map("client_activities")
}

model ProfessionalCredential {
  id             String   @id @default(uuid(7))
  firmId         String
  userId         String
  jurisdictionId String
  registrationNumber String
  status         CredentialStatus @default(ACTIVE)
  validFrom      DateTime
  validTo        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  authority    TaxAuthority @relation(fields: [authorityId], references: [id])
  authorityId  String
  approvals    RuleApproval[]

  @@index([firmId, userId])
  @@index([jurisdictionId])
  @@map("professional_credentials")
}

enum CredentialStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

// --- Períodos y obligaciones ---

model TaxPeriod {
  id        String   @id @default(uuid(7))
  firmId    String
  clientId  String
  taxTypeId String
  startDate DateTime
  endDate   DateTime
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxType     TaxType         @relation(fields: [taxTypeId], references: [id])
  obligations TaxObligation[]
  importBatches ImportBatch[]
  vouchers    FiscalVoucher[]
  adjustments TaxAdjustment[]
  settlements TaxSettlement[]
  profitabilitySnapshots ProfitabilitySnapshot[]

  @@unique([clientId, taxTypeId, startDate, endDate])
  @@index([firmId, clientId, taxTypeId])
  @@map("tax_periods")
}

model TaxObligation {
  id                String   @id @default(uuid(7))
  firmId            String
  clientId          String
  profileVersionId  String
  regimeId          String
  periodId          String
  status            TaxObligationStatus @default(PENDING)
  dueDate           DateTime?
  materializedBy    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profile  TaxpayerProfileVersion @relation(fields: [profileVersionId], references: [id])
  regime   TaxRegime           @relation(fields: [regimeId], references: [id])
  period   TaxPeriod           @relation(fields: [periodId], references: [id])
  filings  TaxFiling[]
  payments TaxPayment[]
  paymentAllocations PaymentAllocation[]
  workpaperLinks WorkpaperSettlement[]
  inputAllocations TaxInputAllocation[]
  documentRequests DocumentRequest[]

  @@unique([clientId, regimeId, periodId])
  @@index([firmId, clientId, status])
  @@index([periodId])
  @@map("tax_obligations")
}

enum TaxObligationStatus {
  PENDING
  WAITING_INPUTS
  READY_TO_CALCULATE
  IN_REVIEW
  READY_TO_FILE
  FILED
  PARTIALLY_PAID
  PAID
  OVERDUE
  NOT_APPLICABLE
}

// --- Reglas fiscales ---

model TaxRulePack {
  id          String   @id @default(uuid(7))
  code        String
  name        String
  regimeId    String
  status      TaxRulePackStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regime   TaxRegime          @relation(fields: [regimeId], references: [id])
  versions TaxRuleVersion[]

  @@unique([code])
  @@index([regimeId])
  @@map("tax_rule_packs")
}

enum TaxRulePackStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  RETIRED
}

model TaxRuleVersion {
  id            String   @id @default(uuid(7))
  packId        String
  version       Int      @default(1)
  status        TaxRulePackStatus @default(DRAFT)
  validFrom     DateTime
  validTo       DateTime?
  rulesHash     String
  engineVersion String
  approvedByUserId String?
  approvedAt    DateTime?
  activatedAt   DateTime?
  supersedesId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pack      TaxRulePack        @relation(fields: [packId], references: [id], onDelete: Cascade)
  approvedBy User?             @relation(fields: [approvedByUserId], references: [id])
  rateRules TaxRateRule[]
  minimumRules TaxMinimumRule[]
  bracketRules TaxBracketRule[]
  dueDateRules DueDateRule[]
  roundingRules RoundingRule[]
  sources   NormativeSource[]
  approvals RuleApproval[]
  treatmentDecisions TaxTreatmentDecision[]
  adjustments TaxAdjustment[]
  settlements TaxSettlement[]

  @@unique([packId, version])
  @@index([packId, status])
  @@map("tax_rule_versions")
}

model TaxRateRule {
  id              String   @id @default(uuid(7))
  ruleVersionId   String
  concept         String
  activityCode    String?
  jurisdictionId  String?
  rate            Decimal? @db.Decimal(10, 6)
  minAmount       Decimal? @db.Decimal(20, 4)
  validFrom       DateTime
  validTo         DateTime?
  createdAt       DateTime @default(now())

  ruleVersion TaxRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@index([ruleVersionId])
  @@map("tax_rate_rules")
}

model TaxMinimumRule {
  id            String   @id @default(uuid(7))
  ruleVersionId String
  concept       String
  jurisdictionId String?
  amount        Decimal  @db.Decimal(20, 4)
  isConditional Boolean  @default(false)
  validFrom     DateTime
  validTo       DateTime?
  createdAt     DateTime @default(now())

  ruleVersion TaxRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@index([ruleVersionId])
  @@map("tax_minimum_rules")
}

model TaxBracketRule {
  id            String   @id @default(uuid(7))
  ruleVersionId String
  concept       String
  fromAmount    Decimal  @db.Decimal(20, 4)
  toAmount      Decimal? @db.Decimal(20, 4)
  rate          Decimal  @db.Decimal(10, 6)
  fixedAmount   Decimal? @db.Decimal(20, 4)
  validFrom     DateTime
  validTo       DateTime?
  createdAt     DateTime @default(now())

  ruleVersion TaxRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@index([ruleVersionId])
  @@map("tax_bracket_rules")
}

model DueDateRule {
  id            String   @id @default(uuid(7))
  ruleVersionId String
  jurisdictionId String
  frequency     String   @default("MONTHLY")
  dueDay        Int
  monthOffset   Int      @default(1)
  cuitEnding    String?
  validFrom     DateTime
  validTo       DateTime?
  createdAt     DateTime @default(now())

  ruleVersion  TaxRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  jurisdiction Jurisdiction   @relation(fields: [jurisdictionId], references: [id])

  @@index([ruleVersionId])
  @@map("due_date_rules")
}

model Holiday {
  id             String   @id @default(uuid(7))
  jurisdictionId String
  date           DateTime
  name           String?
  createdAt      DateTime @default(now())

  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id])

  @@unique([jurisdictionId, date])
  @@map("holidays")
}

model RoundingRule {
  id            String   @id @default(uuid(7))
  ruleVersionId String
  concept       String
  precision     Int      @default(2)
  mode          String   @default("HALF_UP")
  createdAt     DateTime @default(now())

  ruleVersion TaxRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@index([ruleVersionId])
  @@map("rounding_rules")
}

model NormativeSource {
  id            String   @id @default(uuid(7))
  ruleVersionId String
  authorityId   String
  title         String
  url           String?
  reference     String?
  fileChecksum  String?
  consultedAt   DateTime
  createdAt     DateTime @default(now())

  ruleVersion TaxRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  authority   TaxAuthority   @relation(fields: [authorityId], references: [id])

  @@index([ruleVersionId])
  @@map("normative_sources")
}

model RuleApproval {
  id            String   @id @default(uuid(7))
  ruleVersionId String
  credentialId  String
  approvedByUserId String
  comment       String?
  goldenResultsHash String?
  approvedAt    DateTime @default(now())

  ruleVersion TaxRuleVersion        @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  credential  ProfessionalCredential @relation(fields: [credentialId], references: [id])
  approvedBy  User                  @relation(fields: [approvedByUserId], references: [id])

  @@index([ruleVersionId])
  @@map("rule_approvals")
}

// ============================================================
// Puerta 2 — Ingestión y subledger fiscal (G2-01 a G2-10)
// Fuente: PLAN_DESARROLLO_CONTABLE.md §7.4, §7.5, §7.6
// ============================================================

// --- G2-01: Lotes de importación ---

model ImportBatch {
  id            String          @id @default(uuid(7))
  firmId        String
  clientId      String
  origin        String
  taxTypeId     String
  periodId      String
  adapterVersion String
  fileHash      String?
  fileName      String?
  status        ImportBatchStatus @default(UPLOADED)
  totalRows     Int             @default(0)
  validRows     Int             @default(0)
  errorRows     Int             @default(0)
  totals        Json?
  createdByUserId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  client Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxType TaxType       @relation(fields: [taxTypeId], references: [id])
  period  TaxPeriod     @relation(fields: [periodId], references: [id])
  rows    ImportRow[]
  workpapers WorkpaperImportBatch[]

  @@unique([firmId, clientId, origin, taxTypeId, periodId, fileHash])
  @@index([firmId, clientId, periodId])
  @@index([firmId, clientId, status])
  @@map("import_batches")
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  COMMITTED
  FAILED
  CANCELLED
}

// --- F1.2: Registro de adaptadores de importación (PLAN §5.6.2) ---

model ImportAdapter {
  id                 String   @id @default(uuid(7))
  taxTypeId          String
  originCode         String
  direction          String
  sourceSchemaVersion String
  parserVersion      String
  taxScope           String
  fileFormat         String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  taxType TaxType @relation(fields: [taxTypeId], references: [id])

  @@unique([originCode, sourceSchemaVersion])
  @@map("import_adapters")
}

model ImportRow {
  id          String        @id @default(uuid(7))
  firmId      String
  clientId    String
  batchId     String
  position    Int
  raw         Json
  normalized  Json?
  status      ImportRowStatus @default(PENDING)
  errors      String[]      @default([])
  voucherId   String?       @unique
  sourceType  String?
  sourceId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client  Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  voucher FiscalVoucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  evidenceLinks EvidenceLink[]

  @@unique([batchId, position])
  @@index([firmId, clientId, batchId])
  @@index([sourceType, sourceId])
  @@map("import_rows")
}

enum ImportRowStatus {
  PENDING
  VALID
  ERROR
  DUPLICATE
  COMMITTED
}

// --- G2-04: Comprobantes fiscales (FiscalVoucher) y componentes ---

model FiscalVoucher {
  id              String              @id @default(uuid(7))
  firmId          String
  clientId        String
  direction       FiscalVoucherDirection
  type            String
  letter          String?
  pointOfSale     Int
  number          Int
  issuerCuit      String
  receiverCuit    String
  issuedOn        DateTime
  accountingOn    DateTime?
  serviceOn       DateTime?
  currency        String              @default("ARS")
  exchangeRate    Decimal?            @db.Decimal(20, 8)
  exchangeRateSource String?
  total           Decimal             @db.Decimal(20, 4)
  status          FiscalVoucherStatus @default(DRAFT)
  version         Int                 @default(1)
  hash            String?
  duplicateOfId   String?
  documentId      String?
  periodId        String?
  createdByUserId String?
  reviewedByUserId String?
  reviewedAt      DateTime?
  approvedByUserId String?
  approvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  client       Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  document     Document?              @relation(fields: [documentId], references: [id])
  period       TaxPeriod?             @relation(fields: [periodId], references: [id])
  duplicateOf  FiscalVoucher?         @relation("voucherDuplicate", fields: [duplicateOfId], references: [id])
  duplicates   FiscalVoucher[]        @relation("voucherDuplicate")
  lines        FiscalVoucherLine[]
  components   FiscalComponent[]
  importRow    ImportRow?
  evidence     EvidenceLink[]
  adjustments  TaxAdjustment[]
  workpaperClassifications WorkpaperVoucherClassification[]

  @@index([firmId, clientId, issuedOn])
  @@index([firmId, clientId, direction, type, pointOfSale, number])
  @@index([clientId, direction, issuerCuit, type, pointOfSale, number])
  @@map("fiscal_vouchers")
}

enum FiscalVoucherDirection {
  PURCHASE
  SALE
}

enum FiscalVoucherStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

model FiscalVoucherLine {
  id            String   @id @default(uuid(7))
  firmId        String
  clientId      String
  voucherId     String
  position      Int
  description   String?
  activityCode  String?
  quantity      Decimal? @db.Decimal(20, 8)
  unitPrice     Decimal? @db.Decimal(20, 8)
  netAmount     Decimal? @db.Decimal(20, 4)
  createdAt     DateTime @default(now())

  client  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  voucher FiscalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([voucherId, position])
  @@index([firmId, clientId, voucherId])
  @@map("fiscal_voucher_lines")
}

model FiscalComponent {
  id          String   @id @default(uuid(7))
  firmId      String
  clientId    String
  voucherId   String
  concept     String
  base        Decimal  @db.Decimal(20, 4)
  rate        Decimal? @db.Decimal(10, 6)
  amount      Decimal  @db.Decimal(20, 4)
  createdAt   DateTime @default(now())

  client  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  voucher FiscalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([voucherId, concept])
  @@index([firmId, clientId, voucherId])
  @@map("fiscal_components")
}

// --- G2-03: Retenciones y percepciones ---

model WithholdingCertificate {
  id            String    @id @default(uuid(7))
  firmId        String
  clientId      String
  direction     String    @default("SUFFERED")
  cuitAgent     String
  cuitResponsible String
  concept       String
  base          Decimal   @db.Decimal(20, 4)
  amount        Decimal   @db.Decimal(20, 4)
  rate          Decimal?  @db.Decimal(10, 6)
  issuedOn      DateTime
  certificateNumber String?
  sourceDocumentId String?
  taxPeriodId   String?
  // F1.4: alcance fiscal para atribución correcta de créditos.
  taxTypeId     String?
  regimeId      String?
  jurisdictionId String?
  creditKind    String    @default("WITHHOLDING")
  status        String    @default("DRAFT")
  createdByUserId String?
  reviewedByUserId String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([firmId, clientId, issuedOn])
  @@index([firmId, clientId, cuitAgent])
  @@map("withholding_certificates")
}

model PerceptionCertificate {
  id            String    @id @default(uuid(7))
  firmId        String
  clientId      String
  direction     String    @default("SUFFERED")
  cuitAgent     String
  cuitResponsible String
  concept       String
  base          Decimal   @db.Decimal(20, 4)
  amount        Decimal   @db.Decimal(20, 4)
  rate          Decimal?  @db.Decimal(10, 6)
  issuedOn      DateTime
  certificateNumber String?
  sourceDocumentId String?
  taxPeriodId   String?
  // F1.4: alcance fiscal para atribución correcta de créditos.
  taxTypeId     String?
  regimeId      String?
  jurisdictionId String?
  creditKind    String    @default("PERCEPTION")
  status        String    @default("DRAFT")
  createdByUserId String?
  reviewedByUserId String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([firmId, clientId, issuedOn])
  @@index([firmId, clientId, cuitAgent])
  @@map("perception_certificates")
}

// --- G2-08: Gastos gerenciales y tratamiento profesional ---

model ManagementExpense {
  id                String                @id @default(uuid(7))
  firmId            String
  clientId          String
  description       String
  amount            Decimal               @db.Decimal(20, 4)
  currency          String                @default("ARS")
  incurredOn        DateTime
  paidOn            DateTime?
  taxTreatment      TaxTreatment          @default(MANAGEMENT_ONLY)
  status            ManagementExpenseStatus @default(DRAFT)
  hasFiscalSupport  Boolean               @default(false)
  category          String?
  createdByUserId   String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  client   Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  evidence ExpenseEvidence[]
  decisions TaxTreatmentDecision[]

  @@index([firmId, clientId, incurredOn])
  @@map("management_expenses")
}

// C (plan piloto fiscal §7.1): ingresos gerenciales. Separados del dominio
// fiscal: nunca crean comprobante, componente ni ajuste fiscal. Ciclo igual
// que gastos: DRAFT → PENDING_REVIEW → APPROVED | REJECTED.
model ManagementIncome {
  id                String   @id @default(uuid(7))
  firmId            String
  clientId          String
  description       String
  amount            Decimal  @db.Decimal(20, 4)
  currency          String   @default("ARS")
  accruedOn         DateTime
  collectedOn       DateTime?
  category          String?
  status            ManagementExpenseStatus @default(DRAFT)
  evidenceDocumentId String?
  createdByUserId   String
  reviewedByUserId  String?
  reviewedAt        DateTime?
  rejectionComment  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User   @relation("incomeCreatedBy", fields: [createdByUserId], references: [id])
  reviewedBy User? @relation("incomeReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([firmId, clientId, accruedOn])
  @@map("management_incomes")
}
enum TaxTreatment {
  MANAGEMENT_ONLY
  FISCAL_COMPUTABLE
  FISCAL_NON_COMPUTABLE
  PENDING_PROFESSIONAL_DECISION
}

enum ManagementExpenseStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

model ExpenseEvidence {
  id             String   @id @default(uuid(7))
  firmId         String
  clientId       String
  expenseId      String
  documentId     String?
  note           String?
  createdAt      DateTime @default(now())

  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expense  ManagementExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  document Document?         @relation(fields: [documentId], references: [id])

  @@index([firmId, clientId, expenseId])
  @@map("expense_evidence")
}

model TaxTreatmentDecision {
  id               String   @id @default(uuid(7))
  firmId           String
  clientId         String
  expenseId        String
  ruleVersionId    String?
  treatment        TaxTreatment
  reason           String
  evidenceDocumentId String?
  decidedByUserId  String
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expense  ManagementExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  ruleVersion TaxRuleVersion? @relation(fields: [ruleVersionId], references: [id])
  decidedBy User              @relation("treatmentDecidedBy", fields: [decidedByUserId], references: [id])
  adjustments TaxAdjustment[]

  @@index([firmId, clientId, expenseId])
  @@map("tax_treatment_decisions")
}

// --- G2-09: Ajustes y vínculos de evidencia ---

model TaxAdjustment {
  id               String   @id @default(uuid(7))
  firmId           String
  clientId         String
  periodId         String?
  voucherId        String?
  ruleVersionId    String?
  concept          String
  amount           Decimal  @db.Decimal(20, 4)
  reason           String
  treatmentDecisionId String?
  createdByUserId  String
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  period       TaxPeriod?         @relation(fields: [periodId], references: [id])
  voucher      FiscalVoucher?     @relation(fields: [voucherId], references: [id])
  ruleVersion  TaxRuleVersion?    @relation(fields: [ruleVersionId], references: [id])
  decision     TaxTreatmentDecision? @relation(fields: [treatmentDecisionId], references: [id])
  evidenceLinks EvidenceLink[]

  @@index([firmId, clientId, periodId])
  @@map("tax_adjustments")
}

model EvidenceLink {
  id            String   @id @default(uuid(7))
  firmId        String
  clientId      String
  targetType    String
  targetId      String
  fiscalVoucherId String?
  adjustmentId  String?
  documentId    String?
  importRowId   String?
  sourceType    String?
  sourceId      String?
  note          String?
  createdAt     DateTime @default(now())

  client   Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fiscalVoucher FiscalVoucher? @relation(fields: [fiscalVoucherId], references: [id])
  adjustment TaxAdjustment? @relation(fields: [adjustmentId], references: [id])
  document Document?      @relation(fields: [documentId], references: [id])
  importRow ImportRow?    @relation(fields: [importRowId], references: [id])

  @@index([firmId, clientId, targetType, targetId])
  @@map("evidence_links")
}

// --- G2-09/10: Liquidaciones, diferencias y cumplimiento ---

model TaxSettlement {
  id               String             @id @default(uuid(7))
  firmId           String
  clientId         String
  taxTypeId        String
  regimeId         String
  jurisdictionId   String
  periodId         String
  ruleVersionId    String?
  cutoff           DateTime
  version          Int                @default(1)
  engineVersion    String
  rulesHash        String
  inputHash        String
  outputHash       String
  status           TaxSettlementStatus @default(DRAFT)
  totals           Json?
  preparedByUserId String
  reviewedByUserId String?
  reviewedAt       DateTime?
  finalizedByUserId String?
  finalizedAt      DateTime?
  supersedesId     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxType      TaxType            @relation(fields: [taxTypeId], references: [id])
  regime       TaxRegime          @relation(fields: [regimeId], references: [id])
  jurisdiction Jurisdiction       @relation(fields: [jurisdictionId], references: [id])
  period       TaxPeriod          @relation(fields: [periodId], references: [id])
  ruleVersion  TaxRuleVersion?    @relation(fields: [ruleVersionId], references: [id])
  preparedBy   User               @relation("settlementPreparedBy", fields: [preparedByUserId], references: [id])
  reviewedBy   User?              @relation("settlementReviewedBy", fields: [reviewedByUserId], references: [id])
  finalizedBy  User?              @relation("settlementFinalizedBy", fields: [finalizedByUserId], references: [id])
  supersedes   TaxSettlement?     @relation("settlementSupersedes", fields: [supersedesId], references: [id])
  supersededBy TaxSettlement[]    @relation("settlementSupersedes")
  inputs       SettlementInput[]
  lines        TaxSettlementLine[]
  differences  TaxDifference[]
  artifacts    TaxExportArtifact[]
  filings      TaxFiling[]
  payments     TaxPayment[]
  creditAllocations TaxCreditAllocation[]
  workpaperLinks WorkpaperSettlement[]

  @@unique([clientId, regimeId, periodId, version])
  @@index([firmId, clientId, status])
  @@index([firmId, clientId, periodId])
  @@index([ruleVersionId])
  @@map("tax_settlements")
}

enum TaxSettlementStatus {
  DRAFT
  CALCULATED
  IN_REVIEW
  CHANGES_REQUESTED
  REVIEWED
  FINALIZED
  SUPERSEDED
}

model SettlementInput {
  id           String   @id @default(uuid(7))
  firmId       String
  clientId     String
  settlementId String
  kind         String
  sourceId     String
  sourceVersion Int      @default(1)
  snapshot     Json?
  createdAt    DateTime @default(now())

  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  settlement TaxSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, kind, sourceId])
  @@index([firmId, clientId, settlementId])
  @@map("settlement_inputs")
}

model TaxSettlementLine {
  id           String   @id @default(uuid(7))
  firmId       String
  clientId     String
  settlementId String
  position     Int
  concept      String
  formula      String?
  inputs       Json?
  amount       Decimal  @db.Decimal(20, 4)
  createdAt    DateTime @default(now())

  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  settlement TaxSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, position])
  @@index([firmId, clientId, settlementId])
  @@map("tax_settlement_lines")
}

model TaxDifference {
  id           String             @id @default(uuid(7))
  firmId       String
  clientId     String
  settlementId String?
  severity     TaxDifferenceSeverity @default(WARNING)
  status       TaxDifferenceStatus @default(OPEN)
  code         String
  message      String
