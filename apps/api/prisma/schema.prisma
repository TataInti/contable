  amountFiled       Decimal  @db.Decimal(20, 4)
  status            TaxFilingStatus @default(PENDING)
  evidenceDocumentId String?
  createdByUserId   String
  createdAt         DateTime @default(now())

  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  obligation TaxObligation  @relation(fields: [obligationId], references: [id])
  settlement TaxSettlement? @relation(fields: [settlementId], references: [id])
  evidence   Document?      @relation(fields: [evidenceDocumentId], references: [id])

  @@index([firmId, clientId, obligationId])
  @@map("tax_filings")
}

enum TaxFilingStatus {
  PENDING
  FILED
  REJECTED
  VOIDED
}

model TaxPayment {
  id                String   @id @default(uuid(7))
  firmId            String
  clientId          String
  obligationId      String
  settlementId      String?
  paidAt            DateTime
  amount            Decimal  @db.Decimal(20, 4)
  principalAmount   Decimal  @default(0) @db.Decimal(20, 4)
  interestAmount    Decimal  @default(0) @db.Decimal(20, 4)
  method            String
  status            String   @default("PAID")
  reference         String?
  reversedById      String?
  reversedAt        DateTime?
  reversalReason    String?
  createdByUserId   String
  createdAt         DateTime @default(now())

  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  obligation TaxObligation  @relation(fields: [obligationId], references: [id])
  settlement TaxSettlement? @relation(fields: [settlementId], references: [id])
  allocations PaymentAllocation[]

  @@index([firmId, clientId, obligationId])
  @@unique([obligationId, reference])
  @@map("tax_payments")
}

model PaymentAllocation {
  id          String   @id @default(uuid(7))
  firmId      String
  clientId    String
  paymentId   String
  obligationId String
  amount      Decimal  @db.Decimal(20, 4)
  createdAt   DateTime @default(now())

  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payment   TaxPayment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  obligation TaxObligation @relation(fields: [obligationId], references: [id])

  @@index([firmId, clientId, obligationId])
  @@map("payment_allocations")
}

// ============================================================
// Puerta 5 — Rentabilidad gerencial (PLAN §5.7, §7.7)
// ============================================================

model ProfitabilitySnapshot {
  id              String   @id @default(uuid(7))
  firmId          String
  clientId        String
  periodId        String
  basis           ProfitabilityBasis @default(DEVENGADO)
  version         Int      @default(1)
  engineVersion   String
  cutoff          DateTime
  status          ProfitabilitySnapshotStatus @default(DRAFT)
  totals          Json?
  lines           Json?
  inputHash       String
  outputHash      String
  inputIds        Json?
  publishedById   String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  period   TaxPeriod @relation(fields: [periodId], references: [id])

  @@unique([clientId, periodId, basis, version])
  @@index([firmId, clientId, status])
  @@index([firmId, clientId, periodId])
  @@map("profitability_snapshots")
}

enum ProfitabilityBasis {
  DEVENGADO
  CAJA
}

enum ProfitabilitySnapshotStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

// ============================================================
// Fase 1 — Expediente mensual de liquidación (PLAN §5.6)
// ============================================================

enum MonthlyTaxWorkpaperStatus {
  DRAFT
  COLLECTING_INPUTS
  READY_TO_CALCULATE
  CALCULATING
  CALCULATED
  IN_REVIEW
  CHANGES_REQUESTED
  REVIEWED
  FINALIZED
  SUPERSEDED
}

model MonthlyTaxWorkpaper {
  id            String                     @id @default(uuid(7))
  firmId        String
  clientId      String
  periodStart   DateTime
  periodEnd     DateTime
  revision      Int                        @default(1)
  status        MonthlyTaxWorkpaperStatus  @default(DRAFT)
  cutoffAt      DateTime?
  preparedByUserId String?
  reviewedByUserId String?
  finalizedByUserId String?
  supersedesId  String?
  inputHash     String?
  outputHash    String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  client     Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  preparedBy User?                 @relation("workpaperPreparedBy", fields: [preparedByUserId], references: [id])
  reviewedBy User?                 @relation("workpaperReviewedBy", fields: [reviewedByUserId], references: [id])
  finalizedBy User?                @relation("workpaperFinalizedBy", fields: [finalizedByUserId], references: [id])
  supersedes MonthlyTaxWorkpaper?  @relation("workpaperSupersedes", fields: [supersedesId], references: [id])
  supersededBy MonthlyTaxWorkpaper[] @relation("workpaperSupersedes")
  settlements WorkpaperSettlement[]
  sources     WorkpaperImportBatch[]
  classifications WorkpaperVoucherClassification[]
